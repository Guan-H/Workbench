{
  "name": "private-space-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "type-check:verification": "tsc -p tsconfig.verification.json",
    "test": "vitest run",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language-data": "6.5.2",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lucide-vue-next": "0.577.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.18.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.0.7",
    "libsodium-wrappers-sumo": "0.8.4",
    "playwright": "1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
