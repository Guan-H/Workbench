WORKBENCH_DOMAIN=sy.ggh.cool
WORKBENCH_VERSION=replace-with-git-commit-or-release
# Optional HTTP proxy reachable from the backend container; leave blank for direct reading-source requests.
PRIVATE_SPACE_READING_PROXY_URL=
# Optional server-defined presets, retained for earlier registrations. New connections can be added in the UI.
# PRIVATE_SPACE_AI_CUSTOM_PROVIDERS='[{"name":"My gateway","baseUrl":"https://gateway.example.com/v1"}]'
# When using compose.ai.yml, point this to a private server file containing the persistent AI encryption key.
# PRIVATE_SPACE_AI_ENCRYPTION_KEY_FILE=/absolute/path/to/ai-encryption-key
